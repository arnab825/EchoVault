# Git Ignore for EchoVault

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python packaging lib (whitelisting frontend/lib)
!frontend/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# Storage & Uploads
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/echovault.db
backend/data/vector_index.json
backend/data/exports/*
!backend/data/exports/.gitkeep

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Containers
*.log
