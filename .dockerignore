# Ignore build artifacts and local dependencies for fast container builds
node_modules/
frontend/node_modules/
.next/
frontend/.next/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
backend/venv/
backend/.venv/
venv/
.venv/
.pytest_cache/
backend/.pytest_cache/

