# EchoVault Environment Configuration Example

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
DATA_DIR=./data
DATABASE_PATH=./data/echovault.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE_MB=50

# Ollama & Local Inference Settings
# Default connects to local Ollama on standard port 11434
# When running in Podman, use host.containers.internal:11434 or http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60
# Fallback inference if Ollama is offline or model not yet downloaded
ALLOW_OFFLINE_MOCK_FALLBACK=true

# Security & Privacy
SECRET_KEY=echovault-local-secret-change-in-production
ALLOW_TELEMETRY=false
OFFLINE_MODE_STRICT=false

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=EchoVault
NEXT_PUBLIC_VERSION=1.0.0
